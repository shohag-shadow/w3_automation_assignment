{"uid":"dac09d0b4943e48f","name":"test_03[chromium]","fullName":"tests.test_03#test_03","time":{"start":1792495200346,"stop":1792495204038,"duration":3692},"description":"Verifies that book titles and prices stay consistent between the homepage and detail pages.\n\n    This test samples random products from the Books to Scrape homepage, opens each\n    product's detail page, and cross-checks the listing data against the detail data\n    to ensure the catalog presents the same information in both places.\n\n    Validation steps include:\n        1. Confirms the product grid is loaded and the first book card is visible.\n        2. Asserts at least five book cards are available for sampling.\n        3. Randomly selects five distinct book cards from the homepage.\n        4. Opens each selected book and confirms the detail page heading contains\n           the homepage title (trailing dots from truncated titles are ignored).\n        5. Confirms the detail page price matches the homepage price exactly.\n        6. Navigates back and confirms the product grid is restored.\n\n    Args:\n        page (Page): The standard Playwright sync page fixture context injected by pytest.\n\n    Raises:\n        AssertionError: If fewer than five books are listed, or if a title or price\n            differs between the homepage and the detail page.\n    ","descriptionHtml":"<p>Verifies that book titles and prices stay consistent between the homepage and detail pages.</p>\n<pre><code>This test samples random products from the Books to Scrape homepage, opens each\nproduct's detail page, and cross-checks the listing data against the detail data\nto ensure the catalog presents the same information in both places.\n\nValidation steps include:\n    1. Confirms the product grid is loaded and the first book card is visible.\n    2. Asserts at least five book cards are available for sampling.\n    3. Randomly selects five distinct book cards from the homepage.\n    4. Opens each selected book and confirms the detail page heading contains\n       the homepage title (trailing dots from truncated titles are ignored).\n    5. Confirms the detail page price matches the homepage price exactly.\n    6. Navigates back and confirms the product grid is restored.\n\nArgs:\n    page (Page): The standard Playwright sync page fixture context injected by pytest.\n\nRaises:\n    AssertionError: If fewer than five books are listed, or if a title or price\n        differs between the homepage and the detail page.\n</code></pre>\n","status":"passed","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"prepare_artifact_dirs","time":{"start":1792495194139,"stop":1792495194140,"duration":1},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"pytestconfig","time":{"start":1792495194139,"stop":1792495194139,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"delete_output_dir","time":{"start":1792495194139,"stop":1792495194139,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"browser_type_launch_args","time":{"start":1792495194140,"stop":1792495194140,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"playwright","time":{"start":1792495194140,"stop":1792495194453,"duration":313},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"na