{"uid":"1df649746ffd158a","name":"test_05[chromium]","fullName":"tests.test_05#test_05","time":{"start":1792409247546,"stop":1792409252112,"duration":4566},"description":"Verifies product image integrity across the first pages of the Books to Scrape catalog.\n\n    This test walks through the paginated product listing and inspects every book\n    cover image to ensure each one is rendered and carries the attributes the\n    site's markup is expected to provide.\n\n    Validation steps include:\n        1. Confirms each visited page contains at least one product image.\n        2. Asserts every image is visible on screen.\n        3. Asserts every image has a non-empty src attribute.\n        4. Asserts every image has a non-empty alt attribute.\n        5. Asserts every image class list includes the \"thumbnail\" class.\n        6. Follows the \"next\" link to the following page, stopping after five pages\n           or when no further page is available.\n\n    Args:\n        page (Page): The standard Playwright sync page fixture context injected by pytest.\n\n    Raises:\n        AssertionError: If a page has no product images, or if an image is missing\n            its src, alt, or expected \"thumbnail\" class.\n    ","descriptionHtml":"<p>Verifies product image integrity across the first pages of the Books to Scrape catalog.</p>\n<pre><code>This test walks through the paginated product listing and inspects every book\ncover image to ensure each one is rendered and carries the attributes the\nsite's markup is expected to provide.\n\nValidation steps include:\n    1. Confirms each visited page contains at least one product image.\n    2. Asserts every image is visible on screen.\n    3. Asserts every image has a non-empty src attribute.\n    4. Asserts every image has a non-empty alt attribute.\n    5. Asserts every image class list includes the &quot;thumbnail&quot; class.\n    6. Follows the &quot;next&quot; link to the following page, stopping after five pages\n       or when no further page is available.\n\nArgs:\n    page (Page): The standard Playwright sync page fixture context injected by pytest.\n\nRaises:\n    AssertionError: If a page has no product images, or if an image is missing\n        its src, alt, or expected &quot;thumbnail&quot; class.\n</code></pre>\n","status":"passed","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"pytestconfig","time":{"start":1792409229617,"stop":1792409229617,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"_pw_api_request_contexts","time":{"start":1792409229618,"stop":1792409229618,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"prepare_artifact_dirs","time":{"start":1792409229618,"stop":1792409229618,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"playwright","time":{"start":1792409229618,"stop":1792409229954,"duration":336},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"browser_type_launch_args","time":{"start":1792409229618,"stop":1792409229618,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount":0,"attachmentsCount":0,"attachmentStep":false},{"name":"delete_output_dir","time":{"start":1792409229618,"stop":1792409229618,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"hasContent":false,"shouldDisplayMessage":false,"stepsCount"